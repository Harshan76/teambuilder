# =====================================================================
# AI Group Project Team Builder - Environment Configuration Template
# Copy this file to .env for local development or configure in Railway Dashboard
# =====================================================================

# Flask Application Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Port (Railway automatically sets PORT, defaults to 5000)
PORT=5000

# =====================================================================
# MySQL Database Configuration
# Railway automatically injects DATABASE_URL or MYSQL_URL when MySQL is added
# =====================================================================

# Option A: Full Connection URI (Recommended for Railway)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: The app automatically converts mysql:// to mysql+pymysql:// internally
DATABASE_URL=mysql://root:your_mysql_password@containers-us-west-1.railway.app:3306/railway

# Option B: Individual Connection Parameters (Railway also provides these)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=ai_team_builder

# =====================================================================
# Deployment & Data Seeding Settings
# =====================================================================

# Set to 'true' on initial deployment to automatically create demo projects and 24 student profiles
AUTO_SEED=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =====================================================================
# Gunicorn Production Tuning (Optional)
# =====================================================================
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
